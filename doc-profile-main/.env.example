# PostgreSQL (required for Vercel — use Neon, Supabase, or Vercel Postgres)
# Example (Neon): postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-long-random-string"

# Admin credentials (used only during initial seed: npm run db:seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Site Administrator"

# Production URLs (replace after first Vercel deploy)
NEXTAUTH_URL="https://your-project.vercel.app"
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"

# File upload limit (bytes, default 5MB)
MAX_UPLOAD_SIZE=5242880
