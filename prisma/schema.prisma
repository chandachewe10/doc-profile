generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  activityLogs ActivityLog[]
}

model SiteSettings {
  id              String   @id @default("main")
  siteTitle       String
  siteDescription String
  keywords        String?
  ogImage         String?
  footerText      String?
  updatedAt       DateTime @updatedAt
}

model HeroContent {
  id           String   @id @default("main")
  eyebrow      String
  name         String
  nameEmphasis String?
  degrees      String
  roles        String
  tagline      String
  stats        String
  ctaPrimary   String
  ctaSecondary String
  photoUrl     String?
  updatedAt    DateTime @updatedAt
}

model AboutContent {
  id            String   @id @default("main")
  sectionLabel  String
  title         String
  titleEmphasis String?
  lead          String
  body          String
  pillars       String
  updatedAt     DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  icon        String
  title       String
  description String
  tags        String
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String
  description String
  imageUrl    String?
  linkUrl     String?
  linkText    String?
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experience {
  id           String   @id @default(cuid())
  period       String
  organization String
  country      String?
  role         String
  description  String
  skills       String
  sortOrder    Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SkillCategory {
  id        String @id @default(cuid())
  name      String
  skills    String
  sortOrder Int    @default(0)
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  author    String
  role      String?
  avatarUrl String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactInfo {
  id            String   @id @default("main")
  title         String
  titleEmphasis String?
  body          String
  email         String
  location      String?
  updatedAt     DateTime @updatedAt
}

model SocialLink {
  id            String  @id @default(cuid())
  platform      String
  label         String
  url           String
  icon          String?
  sortOrder     Int     @default(0)
  showInFooter  Boolean @default(true)
  showInContact Boolean @default(true)
}

model ResumeFile {
  id        String   @id @default("main")
  filename  String
  url       String
  label     String   @default("Download CV")
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Publication {
  id        String  @id @default(cuid())
  year      String
  title     String
  authors   String
  journal   String
  category  String
  badge     String?
  badgeType String?
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model MediaFile {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  alt       String?
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}

model Award {
  id           String  @id @default(cuid())
  title        String
  year         String?
  organization String?
  description  String?
  sortOrder    Int     @default(0)
  published    Boolean @default(true)
}

model LeadershipRole {
  id           String  @id @default(cuid())
  title        String
  organization String
  url          String?
  description  String?
  period       String?
  sortOrder    Int     @default(0)
  published    Boolean @default(true)
}

model MediaAppearance {
  id          String  @id @default(cuid())
  title       String
  type        String
  outlet      String?
  date        String?
  description String?
  linkUrl     String?
  sortOrder   Int     @default(0)
  published   Boolean @default(true)
}
